# Vzorec. Na strezniku ga prepisi v .env in vpisi prave vrednosti:
#     cp .env.primer .env && nano .env
# Datoteka .env NE sme v git (je v .gitignore) in naj bo berljiva samo tebi:
#     chmod 600 .env

# Geslo zacetnega administratorja. Uporabi se SAMO ob prvem zagonu s prazno
# bazo; potem ga spreminjaj v aplikaciji. Brez njega se aplikacija noce
# zagnati - to je namerno, da na spletu ne pristane ugotovljivo geslo.
#
# Ustvari ga z ukazom (in ga NE izmisli sam):
#     openssl rand -base64 24
TURNIRKO_ADMIN_GESLO=tu-vpisi-dolgo-nakljucno-geslo

# E-posta za potrditvene kode (registracija, pozabljeno geslo, soglasje
# skrbnika). Brez teh nastavitev kode koncajo v dnevniku in se nihce ne more
# registrirati. Podatke dobis pri ponudniku transakcijske poste (npr. Brevo,
# brezplacen paket zadosca) - tam nastavis tudi DNS zapise SPF, DKIM in DMARC
# za svojo domeno, sicer posta konca med nezeleno.
TURNIRKO_POSTA_NACIN=smtp
# Posiljatelj, kot ga vidi prejemnik. Ta nabiralnik NE obstaja in ga nihce ne
# bere - obstaja samo kot podpis avtomatske poste.
TURNIRKO_POSTA_OD=Turnirko <ne-odgovarjaj@turnirko-nt.si>
# Kam naj pade odgovor, ce uporabnik vseeno pritisne "Odgovori". To pa je pravi
# predal, ki ga beres. Pusti prazno, ce takega predala nimas.
TURNIRKO_POSTA_ODGOVOR=info@turnirko-nt.si
# Kam pride obvestilo, ko se igralec registrira, njegov racun pa se ne poveze
# sam z igralcem v sifrantu in caka na tvojo potrditev (kdo, kateri paket, zakaj).
# Brez te vrstice velja info@turnirko-nt.si; za izklop vpisi prazno vrednost.
TURNIRKO_POSTA_ADMIN=info@turnirko-nt.si
TURNIRKO_SMTP_STREZNIK=smtp-relay.brevo.com
TURNIRKO_SMTP_VRATA=587
TURNIRKO_SMTP_UPORABNIK=tu-vpisi-uporabnika
TURNIRKO_SMTP_GESLO=tu-vpisi-geslo-smtp

# Placila (Stripe) - Premium (igralec) in Basic/Plus/Pro (organizator).
#   - TAJNI_KLJUC: v Stripe nadzorni plosci (dashboard.stripe.com) Workbench ->
#     API keys -> Secret key (zacne se s sk_test_ v sandboxu, sk_live_ v
#     pravem). Vpisi ga sam. NIKOLI ga ne deli in ne poganjaj v git.
#   - WEBHOOK_SKRIVNOST in WEBHOOK_ID: NE vpisuj na roke in webhooka ne ustvarjaj
#     v nadzorni plosci (ta ne zna izbrati razlicice API-ja, ki jo bere koda).
#     Ko je kljuc vpisan, pozeni
#         sh ./skripte/stripe-webhook.sh
#     ki webhook ustvari in obe vrednosti zapise sama (docs/NAROCNINE-V-ZIVO.md).
# Brez teh dveh placilo vrne jasno napako namesto da bi se sesulo.
TURNIRKO_STRIPE_TAJNI_KLJUC=tu-vpisi-stripe-tajni-kljuc
TURNIRKO_STRIPE_WEBHOOK_SKRIVNOST=tu-vpisi-stripe-webhook-skrivnost

# Statistika obiska (Umami). Teh treh NE vpisuj na roke: skripta
#     sh ./skripte/vklopi-statistiko.sh
# jih ustvari sama, ce jih v .env se ni. Rocno samo, ce ves, kaj delas -
# in takrat z "openssl rand -hex ...": geslo je del naslova baze
# (postgresql://...), zato ne sme vsebovati znakov / + =, ki jih da base64.
UMAMI_BAZA_GESLO=tu-vpisi-nakljucen-niz-iz-openssl-rand-hex-24
UMAMI_APP_SECRET=tu-vpisi-nakljucen-niz-iz-openssl-rand-hex-32
UMAMI_2FA_KLJUC=tu-vpisi-nakljucen-niz-iz-openssl-rand-hex-32
