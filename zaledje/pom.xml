<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Podedujemo upravljanje verzij odvisnosti od Spring Boota -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.2</version>
		<relativePath/>
	</parent>

	<groupId>si.turnirko</groupId>
	<artifactId>turnirko-zaledje</artifactId>
	<version>0.1.0</version>
	<name>Turnirko - zaledje</name>
	<description>Zaledje (backend) aplikacije za vodenje namiznoteniških turnirjev</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<!-- REST kontrolerji (Spring MVC) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Dostop do baze prek JPA/Hibernate -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Preverjanje vnosov (anotacije @NotBlank, @NotNull ipd. na DTO-jih) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Avtentikacija in avtorizacija: gost bere (GET javno), admin (sodnik)
		     se prijavi in edini sme spreminjati podatke (POST/PUT/DELETE). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Verzionirane migracije sheme baze - shema je definirana IZKLJUČNO
		     v datotekah db/migration, Hibernate je nikoli ne spreminja.
		     V Boot 4 je Flyway integracija v modulu spring-boot-flyway;
		     sam flyway-core brez njega ob zagonu NE izvede migracij. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>

		<!-- Gonilnik za SQLite (lokalna datotečna baza) -->
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
		</dependency>

		<!-- Hibernate narečje za SQLite -->
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-community-dialects</artifactId>
		</dependency>

		<!-- Testi -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Profil "splet": zgradi vmesnik in ga vlozi v isti .jar kot zaledje.
		     Rezultat je ENA datoteka, ki strezhe API in stran - brez CORS,
		     brez locenega gostovanja, brez posebnega streznika za datoteke.

		     Namenoma NI privzet: obicajen razvojni prevod (mvnw test/package)
		     ostane hiter, vmesnik pa med razvojem tece na Vite (vrata 5173),
		     ki zna vroce osvezevanje.

		     Uporaba:  mvnw -Psplet package     ->  target/turnirko-zaledje-*.jar -->
		<profile>
			<id>splet</id>
			<build>
				<plugins>
					<!-- Node si prenese sam, v target/. Tako je prevod enak na
					     razvijalcevem racunalniku in v Dockerju, ne glede na to,
					     kaj je slucajno namesceno na sistemu. -->
					<plugin>
						<groupId>com.github.eirslett</groupId>
						<artifactId>frontend-maven-plugin</artifactId>
						<version>1.15.1</version>
						<configuration>
							<workingDirectory>../vmesnik</workingDirectory>
							<installDirectory>${project.build.directory}/node</installDirectory>
						</configuration>
						<executions>
							<execution>
								<id>namesti-node</id>
								<goals><goal>install-node-and-npm</goal></goals>
								<configuration>
									<nodeVersion>v22.20.0</nodeVersion>
								</configuration>
							</execution>
							<execution>
								<id>namesti-odvisnosti</id>
								<goals><goal>npm</goal></goals>
								<configuration>
									<!-- ci (in ne install) namesti tocno tisto, kar
									     pise v package-lock.json -->
									<arguments>ci</arguments>
								</configuration>
							</execution>
							<execution>
								<id>zgradi-vmesnik</id>
								<goals><goal>npm</goal></goals>
								<configuration>
									<arguments>run build</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>

					<!-- Zgrajen vmesnik pristane v static/, od koder ga postreze
					     SpletniVmesnik. -->
					<plugin>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<execution>
								<id>vlozi-vmesnik</id>
								<phase>process-resources</phase>
								<goals><goal>copy-resources</goal></goals>
								<configuration>
									<outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
									<resources>
										<resource>
											<directory>../vmesnik/dist</directory>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
