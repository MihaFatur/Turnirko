# Caddy stoji pred aplikacijo in opravi dve stvari:
#   1. prekine HTTPS - certifikat od Let's Encrypt pridobi in obnavlja SAM,
#      brez skript in brez opomnikov v koledarju;
#   2. zahteve poslje naprej aplikaciji po notranjem omrezju vsebnikov.
#
# E-posta gre Let's Encryptu za opozorila, ce bi obnavljanje certifikata kdaj
# odpovedalo. Naslov mora biti tak, ki ga res beres.

{
	email info@turnirko-nt.si
}

turnirko-nt.si, www.turnirko-nt.si {
	# Stisnjeni odgovori - v dvorani je mobilno omrezje pogosto slabo,
	# vmesnik pa je nekaj sto kilobajtov.
	encode zstd gzip

	# "app" je ime storitve iz compose.yaml; Docker ga razresi v notranji
	# naslov. Vrata 8080 niso izpostavljena navzven (glej compose.yaml) -
	# do aplikacije se pride SAMO skozi Caddy, torej samo prek HTTPS.
	reverse_proxy app:8080

	# Glave, ki brskalniku povejo, cesa naj ne pocne. HSTS pomeni: to
	# stran odslej odpiraj samo prek HTTPS, tudi ce kdo poslje povezavo
	# http://. Vklopi ga sele, ko stran deluje - velja eno leto in ga ni
	# mogoce hitro preklicati.
	#
	# NAMENOMA brez "includeSubDomains": poddomene te domene (razen
	# statistika., spodaj) niso na tem strezniku. webmail. in mail. sta pri
	# gostitelju domene, poddomene za povezave v posti pa pri ponudniku
	# transakcijske poste. Pravilo, ki bi
	# veljalo za vse poddomene, bi brskalniku vsililo HTTPS tudi tam, kjer
	# ga ne nadziramo - in ce kateri od njih odpove, tega ni mogoce hitro
	# popraviti, ker si brskalnik pravilo zapomni za eno leto.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	# Ko aplikacije ni (posodobitev, preklop baze, sesutje), Caddy namesto
	# prazne napake 502 pokaze to stran. Gledalec iz dvorane tako ve, da gre
	# za vzdrzevanje in naj osvezi stran, ne da je Turnirko izginil.
	# Koda 503 s `Retry-After` pove iskalnikom, da je izpad zacasen.
	handle_errors {
		@vzdrzevanje expression `{err.status_code} in [502, 503, 504]`
		handle @vzdrzevanje {
			header Content-Type "text/html; charset=utf-8"
			header Cache-Control "no-store"
			header Retry-After "300"
			respond <<HTML
				<!doctype html>
				<html lang="sl">
				<head>
				<meta charset="utf-8">
				<meta name="viewport" content="width=device-width, initial-scale=1">
				<meta http-equiv="refresh" content="60">
				<title>Vzdrževanje – Turnirko</title>
				<style>
				body { margin: 0; padding: 24px 16px; background: #f4f1ea; color: #1b1b1b;
				       font: 17px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
				main { max-width: 34rem; margin: 12vh auto 0; padding-left: 16px; border-left: 4px solid #0088ce; }
				h1 { margin: 0 0 8px; font-size: 1.6rem; }
				p { margin: 0 0 12px; }
				small { color: #555; }
				</style>
				</head>
				<body>
				<main>
				<h1>Turnirko je v vzdrževanju</h1>
				<p>Kmalu bo spet na voljo. Rezultati in lestvice niso izgubljeni.</p>
				<p>Ta stran se osveži sama; lahko jo osvežiš tudi ročno.</p>
				<small>Če traja dlje kot pol ure, piši na info@turnirko-nt.si.</small>
				</main>
				</body>
				</html>
				HTML 503
		}
	}

	# Dnevnik dostopov - ob tezavah je to prvo, kar pogledas.
	log {
		output file /var/log/caddy/dostop.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# TESTNO okolje (compose.test.yaml, docs/TESTNO-OKOLJE.md): druga kopija
# Turnirka s kopijo prave baze. Ker so v njej pravi podatki in nepreverjena
# koda, je zaklenjena s SKRITO POVEZAVO in ne z geslom: aplikacija sama
# uporablja glavo Authorization, zato bi geslo na vratih Caddyja (basic auth)
# trcilo z njeno prijavo. Postopek:
#   1. obiskovalec odpre https://test.turnirko-nt.si/odpri/<TEST_ZETON>
#   2. Caddy mu nastavi pisckot test_dostop (30 dni) in ga preusmeri na /
#   3. vsaka zahteva brez tega pisckota dobi 404, kot da strani ni.
# TEST_ZETON je v .env produkcije (tja ga zapise skripte/test/nastavi.sh) in
# pride v Caddy prek compose.yaml. Brez njega (prazno) ne spusti nikogar.
# Ce test-app ne tece, obiskovalec z zetonom dobi 503 (to ne vpliva na produkcijo).
test.turnirko-nt.si {
	encode zstd gzip

	header {
		# Iskalniki testa ne smejo indeksirati.
		X-Robots-Tag "noindex, nofollow, noarchive"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	@vstop path /odpri/{$TEST_ZETON}
	handle @vstop {
		# Zetona ne zapisuj v dnevnik dostopov.
		log_skip
		header Set-Cookie "test_dostop={$TEST_ZETON}; Path=/; Max-Age=2592000; Secure; HttpOnly; SameSite=Lax"
		redir / 303
	}

	# "!= \"\"" je varovalka: ce zetona v okolju ni, izraz ne pusti nikogar.
	@dovoljen expression `"{$TEST_ZETON}" != "" && {http.request.cookie.test_dostop} == "{$TEST_ZETON}"`
	handle @dovoljen {
		reverse_proxy test-app:8080
	}

	handle {
		respond "Ni najdeno" 404
	}

	handle_errors {
		respond "Testno okolje trenutno ne tece." 503
	}
}

# Statistika obiska (Umami, storitev "umami" iz compose.yaml). Na tem naslovu
# je pregled za lastnika, od tod pa se nalozi tudi skript obisk.js, ki ga
# turnirko-nt.si vkljuci in ki sem posilja oglede. Certifikat Caddy pridobi
# sam - a SAMO, ce zapis DNS za "statistika" ze kaze na ta streznik.
statistika.turnirko-nt.si {
	encode zstd gzip
	reverse_proxy umami:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}
}
